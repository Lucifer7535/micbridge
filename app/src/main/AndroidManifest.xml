<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.dedsec.micbridge"
    android:versionCode="11"
    android:versionName="1.5">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:label="MicBridge"
        android:supportsRtl="true">

        <!-- Acts as the device-wide speech recognition UI. SmartTube / other
             apps launch RecognizerIntent.ACTION_RECOGNIZE_SPEECH and there is
             no handler on this firmware, so this activity fills that gap. -->
        <activity
            android:name=".RecognizeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Remote-friendly whitelist: which apps get the mic key. Appears in
             the TV launcher's app row. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="MicBridge settings"
            android:banner="@drawable/banner"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MicA11yService"
            android:exported="true"
            android:label="MicBridge"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y_config" />
        </service>
    </application>
</manifest>
